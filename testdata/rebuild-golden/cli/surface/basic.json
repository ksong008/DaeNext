      "version": "unknown"
    },
    "stdout_trailing_newline": true
  },
  "name": "cli-surface-basic",
  "notes": "Rust CLI must preserve command names, visible flags, progress bytes, file paths, validate/export/completion surfaces, and reload/suspend abort path.",
  "paths": {
    "abort_file": "/var/run/dae.abort",
    "pid_file": "/var/run/dae.pid",
    "signal_progress_file": "/var/run/dae.progress"
  },
  "reload_progress": {
    "done": "2",
    "error": "3",
    "processing": "1",
    "send": "0"
  },
  "root": {
    "completion_default_cmd_disabled": true,
    "short": "dae is a high-performance transparent proxy solution.",
    "use": "dae [flags] [command [argument ...]]",
    "version_contains_agpl": true,
    "version_contains_go_runtime": true,
    "version_line_count": 4
  },
  "source": [
    "cmd/cmd.go",
    "cmd/run.go",
    "cmd/reload.go",
    "cmd/suspend.go",
    "cmd/validate.go",
    "cmd/export.go",
    "cmd/completion.go",
    "engine/helpers.go",
    "install/dae.service",
    "common/consts/reload.go"
  ],
  "validate": {
    "cases": [
      {
        "exit_on_error": 1,
        "include_count": 1,
        "name": "minimal-valid",
        "ok": true,
        "stdout_on_ok": ""
      },
      {
        "error_contains": "no viable alternative at input",
        "exit_on_error": 1,
        "name": "syntax-error",
        "ok": false,
        "stdout_on_ok": ""
      }
    ],
    "does_not_start_runtime": true,
    "read_config_function": "engine.ReadConfigFile",
    "requires_config_message": "Argument \"--config\" or \"-c\" is required but not provided.",
    "systemd_exec_start_pre": "/usr/bin/dae validate -c /etc/dae/config.dae",
    "systemd_uses_validate": true
  }
}
